{
  "name": "ts-ai-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts src/db/migrate.ts --target bun --outdir dist --sourcemap=external",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
