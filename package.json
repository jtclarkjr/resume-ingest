{
  "name": "resume-ingest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:bun": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts src/db/migrate.ts src/db/backfill-parses.ts --target bun --outdir dist --sourcemap=external",
    "db:migrate": "bun src/db/migrate.ts",
    "db:backfill-parses": "bun src/db/backfill-parses.ts",
    "smoke:deployment": "bun scripts/smoke-deployment.ts",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "ai": "7.0.58",
    "file-type": "^22.0.2",
    "hono": "^4.13.5",
    "mongodb": "^6.21.0",
    "unpdf": "1.8.0",
    "word-extractor": "1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/word-extractor": "1.0.6",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.80.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
