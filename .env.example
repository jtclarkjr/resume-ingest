NODE_ENV=development
PORT=3000

# Added automatically when the existing MongoDB Atlas integration is connected.
MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/
MONGODB_DB_NAME=resume_ingest

# Added automatically when the private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Generate a random 32-byte value. Never commit the real key.
DOCUMENT_API_KEY=replace-with-a-long-random-secret

# Vercel deployments receive VERCEL_OIDC_TOKEN automatically. For direct local
# development outside `vercel dev`, set an AI Gateway key instead.
AI_GATEWAY_API_KEY=replace-with-a-local-gateway-key
RESUME_PARSER_MODEL=openai/gpt-5.4-mini
