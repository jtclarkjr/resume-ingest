NODE_ENV=development
PORT=4001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/realtime_chat
POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# Configure HS256, or configure a Supabase URL/JWKS URL for ES256.
JWT_SECRET=
SUPABASE_JWT_SECRET=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWKS_URL=

AI_BRIDGE_BASE_URL=http://localhost:4000
AI_BRIDGE_TOKEN=
AI_BRIDGE_TIMEOUT_MS=30000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
SAKANA_API_KEY=
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_REASONING_EFFORT=
TAVILY_API_KEY=

AI_STREAM_DEFAULT_MODEL=auto
AI_AGENT_SEARCH_MODEL=
AI_CHANNEL_SUGGESTION_MODEL=openai:gpt-5.6-luna
AI_FALLBACK_MODEL=openai:gpt-5.4-mini
AI_ALLOWED_MODELS=

AI_SEARCH_DRIVER=provider_native_web_search
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_MAX_USES=2
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_TIMEOUT_MS=6000
AI_WEB_SEARCH_QUOTA_COOLDOWN_MS=3600000
AI_AGENT_MAX_STEPS=6
AI_AGENT_MAX_PLAN_STEPS=4
AI_AGENT_MAX_SEARCH_ACTIONS=2

AI_USAGE_WEEKLY_LIMIT_FREE=250000
AI_USAGE_WEEKLY_LIMIT_TIER_1=250000
AI_USAGE_WEEKLY_LIMIT_TIER_2=1000000
AI_USAGE_WEEKLY_LIMIT_TIER_3=3000000
AI_USAGE_GUEST_LIFETIME_LIMIT=25000
AI_USAGE_TOKEN_CHAR_DIVISOR=4
AI_USAGE_MIN_CHAT_BUDGET=2048
AI_USAGE_MIN_CHANNEL_SUGGESTION_BUDGET=512
AI_USAGE_RESERVATION_TTL_MS=600000

AI_STREAM_MAX_OUTPUT_TOKENS=25000
AI_STREAM_SEARCH_MAX_OUTPUT_TOKENS=4096
AI_STREAM_REQUEST_TIMEOUT_MS=20000
AI_STREAM_SEARCH_TIMEOUT_MS=45000
AI_STREAM_TIMEOUT_RETRY_COUNT=1
